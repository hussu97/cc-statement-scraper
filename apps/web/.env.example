# Local Supabase (values from `supabase status -o json`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Optional: Sentry (ledger-web project). Leave empty to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_RELEASE=
# Build-time only (CI / Vercel): uploads source maps when set.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=ledger-web
