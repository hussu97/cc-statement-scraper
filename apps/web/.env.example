# Local Supabase (values from `supabase status -o json`: API_URL, PUBLISHABLE_KEY).
# Publishable key only (sb_publishable_…) — never a secret key (sb_secret_…) in the browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: Sentry (credit-card-ledger-apps project, shared with iOS; events tagged app=web). Leave empty to disable.
VITE_SENTRY_DSN=
# Sentry stays OFF when this is empty, local, development or test, and on the Vite dev server,
# even with a DSN. Deployed builds must set it (e.g. production, preview).
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_RELEASE=
# Optional: public TestFlight link (https://testflight.apple.com/join/…). Shows the
# "Get the Bank Ledger app" button in Settings → iPhone SMS; hidden when empty.
VITE_TESTFLIGHT_URL=
# Build-time only (CI / Vercel): uploads source maps when set.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=credit-card-ledger-apps
# Build-time only (Vercel): TEAMID.bundle.id[,…]. The build writes
# /.well-known/apple-app-site-association (passkeys) from it; nothing is served when unset.
# LEDGER_APPLE_APP_IDS=
