# Local Supabase (values from `supabase status -o json`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Optional: Sentry (ledger-apps project, shared with iOS; events tagged app=web). Leave empty to disable.
VITE_SENTRY_DSN=
# Sentry stays OFF when this is empty, local, development or test, and on the Vite dev server,
# even with a DSN. Deployed builds must set it (e.g. production, preview).
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_RELEASE=
# Build-time only (CI / Vercel): uploads source maps when set.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=ledger-apps
