{
  "name": "@ledger/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "pnpm --filter @ledger/tokens build",
    "predev": "pnpm run tokens",
    "dev": "vite",
    "prebuild": "pnpm run tokens",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
