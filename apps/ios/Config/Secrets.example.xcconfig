// Template for both gitignored secrets files. Never print or commit either.
//   Config/Secrets.xcconfig          Debug builds only (simulator, local stack)
//   Config/Secrets.Release.xcconfig  Release builds only (TestFlight), production values
// Release never reads Secrets.xcconfig: a key missing from Secrets.Release.xcconfig is
// empty and fails the build (scripts/release-config-check.sh), it does not fall back.
// `//` starts a comment in xcconfig: keep the `$()` between the URL slashes.

// Local: `supabase start`, then `supabase status -o json` → PUBLISHABLE_KEY.
// Production: dashboard → Settings → API Keys → publishable key. Never a sb_secret_ key.
// The simulator reaches the Mac's loopback, so 127.0.0.1 works there.
// Release must be https and not local, e.g. https:/$()/<ref>.supabase.co
LEDGER_SUPABASE_URL = http:/$()/127.0.0.1:54321
LEDGER_SUPABASE_PUBLISHABLE_KEY = <sb_publishable_… key>

// Sentry project `credit-card-ledger-apps` (shared with web) → Client Keys (DSN).
// Debug: leave empty (Sentry never reports locally). Release: required.
LEDGER_SENTRY_DSN =
// local | preview | production. Release must be `production`.
LEDGER_ENVIRONMENT = local

// Release only, optional (not secrets): where scripts/sentry-release.sh sends dSYMs and
// the release when SENTRY_ORG / SENTRY_PROJECT are not set in the shell.
// SENTRY_ORG = <org slug>
// SENTRY_PROJECT = credit-card-ledger-apps
// Never SENTRY_AUTH_TOKEN here: in an xcconfig it is an Xcode build setting, and
// testflight.sh refuses it. Keep it in the login keychain:
//   security add-generic-password -U -s ledger-sentry-auth-token -a "$USER" -w
// (prompts for the value) or export it in the shell.
