// Shared by every target and configuration. No backend values here: Debug.xcconfig
// holds the local defaults (+ the gitignored Secrets.xcconfig), Release.xcconfig reads
// only the gitignored Secrets.Release.xcconfig (BACKLOG IOS-21r).

// Bundle ids: app = prefix, share extension = prefix.share.
LEDGER_BUNDLE_PREFIX = com.hussu97.ledger
LEDGER_APP_GROUP = group.$(LEDGER_BUNDLE_PREFIX)
LEDGER_KEYCHAIN_GROUP = $(LEDGER_BUNDLE_PREFIX).shared
// Passkey relying party (= Supabase [auth.webauthn] rp_id = the web app host).
LEDGER_PASSKEY_DOMAIN = cc-statement-scraper.vercel.app

// Same Apple team as mm-pos. The Team ID is the certificate's OU, not the
// ten characters in its common name.
DEVELOPMENT_TEAM = 2F94NY8R3T
CODE_SIGN_STYLE = Automatic

MARKETING_VERSION = 1.0.0
// Overridden by scripts/publish-build.sh from build-number.json.
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 1
