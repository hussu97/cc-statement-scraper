# Runtime settings seed supports profile-scoped keys.
# Preferred format per profile:
#   <PROFILE_KEY>_<SETTING_KEY>=...
# Example:
#   ALICE_FAB_USERNAME=...
#   BOB_MASHREQ_USERNAME=...
#
# Supported profile aliases for the same behavior:
#   <PROFILE_KEY>__<SETTING_KEY>=...

# Alice profile runtime settings
ALICE_FAB_USERNAME=
ALICE_FAB_PASSWORD=
ALICE_ADCB_CID=
ALICE_ADCB_LOGIN_PASSWORD=
ALICE_ADCB_PDF_PASSWORD=
ALICE_ADCB_FORCE_VIRTUAL_KEYBOARD=1
ALICE_ENBD_USERNAME=
ALICE_ENBD_PASSWORD=
ALICE_EIB_USERNAME=
ALICE_EIB_PASSWORD=
ALICE_SIB_USER_ID=
ALICE_SIB_PASSWORD=
ALICE_SIB_PDF_PASSWORD=
ALICE_SIB_SECURE_IMAGE_TEMPLATE_BASE64=
ALICE_MASHREQ_USERNAME=
ALICE_MASHREQ_PASSWORD=
ALICE_CCS_DOWNLOADS_DIR=~/Downloads

# Bob profile runtime settings
BOB_FAB_USERNAME=
BOB_FAB_PASSWORD=
BOB_ADCB_CID=
BOB_ADCB_LOGIN_PASSWORD=
BOB_ADCB_PDF_PASSWORD=
BOB_ADCB_FORCE_VIRTUAL_KEYBOARD=
BOB_ENBD_USERNAME=
BOB_ENBD_PASSWORD=
BOB_EIB_USERNAME=
BOB_EIB_PASSWORD=
BOB_SIB_USER_ID=
BOB_SIB_PASSWORD=
BOB_SIB_PDF_PASSWORD=
BOB_SIB_SECURE_IMAGE_TEMPLATE_BASE64=
BOB_MASHREQ_USERNAME=
BOB_MASHREQ_PASSWORD=
BOB_CCS_DOWNLOADS_DIR=~/Downloads

# Optional paths
CCS_DOWNLOADS_DIR=~/Downloads

# Platform API/worker settings
CCS_PLATFORM_ENVIRONMENT=development
CCS_PLATFORM_DATABASE_URL=sqlite:///data/state/platform.db
CCS_PLATFORM_STORAGE_BACKEND=local
CCS_PLATFORM_LOCAL_STORAGE_DIR=data/archive/platform
CCS_PLATFORM_TIMEZONE=Asia/Dubai
CCS_PLATFORM_EMBEDDED_WORKER=true
# database: API enqueues queued rows; worker loop consumes.
# inprocess: API process executes jobs directly (use with CCS_PLATFORM_EMBEDDED_WORKER=false).
CCS_PLATFORM_JOB_DISPATCH_BACKEND=database
# Worker queue partitions consumed by this process.
# Use `default` for lightweight jobs and `scrape` for browser-heavy jobs.
# Example for dedicated scrape worker: CCS_PLATFORM_WORKER_QUEUES=scrape
CCS_PLATFORM_WORKER_QUEUES=default,scrape
CCS_PLATFORM_JOB_RETRY_BASE_SECONDS=30
CCS_PLATFORM_JOB_RETRY_JITTER_SECONDS=15
CCS_PLATFORM_JOB_RETRY_MAX_DELAY_SECONDS=900
# Running jobs without heartbeat updates beyond this threshold are recovered.
CCS_PLATFORM_JOB_HEARTBEAT_TIMEOUT_SECONDS=1800
CCS_PLATFORM_CORS_ALLOW_ORIGINS=*
CCS_PLATFORM_LOG_LEVEL=INFO
CCS_PLATFORM_REQUEST_LOGGING_ENABLED=true
# Keep false in production unless you intentionally accept data loss on schema mismatch.
CCS_PLATFORM_ALLOW_LEGACY_SQLITE_RESET=true
# In production set this true and provide CCS_PLATFORM_API_AUTH_TOKEN.
CCS_PLATFORM_REQUIRE_API_AUTH=false
CCS_PLATFORM_API_AUTH_TOKEN=
CCS_PLATFORM_API_AUTH_EXEMPT_PATHS=/api/v1/health,/api/v1/health/ready
# In production leave unset/false to avoid returning secret values from runtime settings APIs.
# CCS_PLATFORM_RUNTIME_SETTINGS_EXPOSE_SECRETS=false
# Encryption is required in production by default.
# Optional override for non-production:
# CCS_PLATFORM_RUNTIME_SETTINGS_REQUIRE_ENCRYPTION=false
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CCS_PLATFORM_RUNTIME_SETTINGS_ENCRYPTION_KEY=
# Runtime settings seed source:
# env_file_then_env (default in development), env (default in production), env_file, none
# CCS_PLATFORM_RUNTIME_SETTINGS_SEED_SOURCE=env
# Optional override for the source .env file path when env_file* modes are used.
# CCS_PLATFORM_RUNTIME_SETTINGS_ENV_FILE=/app/.env

# GCS backend (only required when CCS_PLATFORM_STORAGE_BACKEND=gcs)
# CCS_PLATFORM_GCS_BUCKET=
# CCS_PLATFORM_GCS_PROJECT=
# CCS_PLATFORM_GCS_CREDENTIALS_FILE=
