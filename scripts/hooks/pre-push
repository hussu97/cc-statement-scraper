#!/usr/bin/env bash
# Pre-push hook — CI mirror (runs on git push)
# Catches failures before wasting GitHub Actions minutes.
# Skip with: git push --no-verify
#
# Every section skips cleanly when its directory or tool is missing, so the hook
# keeps working after legacy backend/ and frontend/ are deleted (PRODUCTION.md
# §10 step 12) and on machines without every toolchain installed.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

pass() { echo -e "${GREEN}✓${NC} $1"; }
fail() { echo -e "${RED}✗${NC} $1"; }
info() { echo -e "${YELLOW}→${NC} $1"; }
skip() { echo "  $1 — skipping"; }
section() { echo -e "\n${BLUE}══ $1 ══${NC}"; }

ERRORS=0

# run_check <label> <command...>: runs in a subshell so a failed `cd` never leaks.
run_check() {
  local label="$1"; shift
  info "$label..."
  if ( "$@" ) 2>&1; then
    pass "$label OK"
  else
    fail "$label failed"
    ERRORS=$((ERRORS + 1))
  fi
}

# ===========================================================================
section "LEDGER v2"
# ===========================================================================

# Edge Functions (deno unit tests; e2e is opt-in and not run here)
if [ -d supabase/functions ]; then
  if command -v deno >/dev/null 2>&1; then
    run_check "Edge Functions (deno test)" bash -c 'cd supabase/functions && deno test -A -q .'
  else
    skip "deno not found (brew install deno)"
  fi
fi

# Parser (ruff + pytest)
if [ -d services/parser ]; then
  if [ -x services/parser/.venv/bin/pytest ] && [ -x services/parser/.venv/bin/ruff ]; then
    run_check "Parser (ruff)" bash -c 'cd services/parser && .venv/bin/ruff check .'
    run_check "Parser (pytest)" bash -c 'cd services/parser && .venv/bin/pytest -q'
  else
    skip "services/parser/.venv not set up (see services/parser/README.md)"
  fi
fi

# Web (tokens drift, lint, unit tests)
if [ -d apps/web ]; then
  if command -v pnpm >/dev/null 2>&1 && [ -d node_modules ]; then
    run_check "Tokens (Tokens.swift drift)" pnpm --silent --filter @ledger/tokens check
    run_check "Web lint" pnpm --silent --filter @ledger/web lint
    run_check "Web tests (Vitest)" pnpm --silent --filter @ledger/web test
  else
    skip "pnpm or node_modules missing (corepack enable && pnpm install)"
  fi
fi

# DB types drift — only when the local Supabase stack is running.
if command -v supabase >/dev/null 2>&1 && command -v pnpm >/dev/null 2>&1 \
   && supabase status >/dev/null 2>&1; then
  run_check "DB types drift" pnpm --silent db:types:check
else
  skip "DB types drift: local Supabase stack not running"
fi

# Scraper
if [ -d scraper ]; then
  if [ -x scraper/.venv/bin/pytest ]; then
    run_check "Scraper tests" bash -c 'cd scraper && .venv/bin/pytest -q'
  else
    skip "scraper/.venv not found (cd scraper && pip install -e '.[dev]')"
  fi
fi

# ===========================================================================
# LEGACY v1 — removed at decommission. Each block runs only if its dir exists.
# ===========================================================================
if [ -d backend/ccs_platform ]; then
  section "LEGACY BACKEND"

  LEGACY_PYTHON=""
  if [ -x backend/.venv/bin/python ]; then
    LEGACY_PYTHON="$REPO_ROOT/backend/.venv/bin/python"
  else
    LEGACY_PYTHON="$(command -v python3 || command -v python || true)"
  fi

  if [ -n "$LEGACY_PYTHON" ]; then
    LEGACY_PY_DIRS="backend/ccs_platform"
    [ -d backend/scripts ] && LEGACY_PY_DIRS="$LEGACY_PY_DIRS backend/scripts"
    # shellcheck disable=SC2086
    run_check "Python syntax" "$LEGACY_PYTHON" -m compileall -q $LEGACY_PY_DIRS
    # Force a non-production environment so the session-key validation never fires.
    run_check "Backend tests (pytest)" bash -c \
      "cd backend && CCS_PLATFORM_ENVIRONMENT=test '$LEGACY_PYTHON' -m pytest -q"
  else
    skip "python not found"
  fi

  BANDIT="$(command -v bandit || true)"
  if [ -z "$BANDIT" ] && [ -x backend/.venv/bin/bandit ]; then
    BANDIT="backend/.venv/bin/bandit"
  fi
  if [ -n "$BANDIT" ]; then
    run_check "Bandit SAST" "$BANDIT" -q -r backend/ccs_platform -x backend/tests -ll -ii
  else
    skip "bandit not found (pip install bandit)"
  fi
fi

if [ -f frontend/package.json ]; then
  section "LEGACY FRONTEND"
  if [ -d frontend/node_modules ]; then
    run_check "ESLint" bash -c 'cd frontend && npm run lint --silent'
    run_check "Frontend tests (Vitest)" bash -c 'cd frontend && npm test -- --run'
    run_check "Frontend build (tsc + vite)" bash -c 'cd frontend && npm run build'
  else
    skip "frontend/node_modules missing (cd frontend && npm ci)"
  fi
fi

# ---------------------------------------------------------------------------
echo ""
if [ "$ERRORS" -gt 0 ]; then
  echo -e "${RED}Pre-push failed ($ERRORS check(s)). Fix the issues above before pushing.${NC}"
  echo -e "${RED}To bypass: git push --no-verify (only when you know what you're doing)${NC}"
  exit 1
else
  echo -e "${GREEN}All checks passed — safe to push.${NC}"
fi
