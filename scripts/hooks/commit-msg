#!/usr/bin/env bash
# Commit message hook — enforce the project commit author identity and reject
# co-author trailers (CLAUDE.md §4: no Co-Authored-By trailer of any kind).

set -euo pipefail

REQUIRED_NAME="Hussain Abbasi"
REQUIRED_EMAIL="h_abbasi97@hotmail.com"
MSG_FILE="${1:-}"

AUTHOR_NAME="${GIT_AUTHOR_NAME:-$(git config user.name || true)}"
AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-$(git config user.email || true)}"

if [ "$AUTHOR_NAME" != "$REQUIRED_NAME" ] || [ "$AUTHOR_EMAIL" != "$REQUIRED_EMAIL" ]; then
  echo "Commit author must be exactly:"
  echo "  $REQUIRED_NAME <$REQUIRED_EMAIL>"
  echo ""
  echo "Current author:"
  echo "  ${AUTHOR_NAME:-<unset>} <${AUTHOR_EMAIL:-unset}>"
  echo ""
  echo "Use:"
  echo "  git commit --author=\"$REQUIRED_NAME <$REQUIRED_EMAIL>\" -m \"...\""
  exit 1
fi

# Ignore comment lines (git strips them) when looking for trailers.
if [ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] \
   && grep -v '^#' "$MSG_FILE" | grep -qiE '^[[:space:]]*co-authored-by:'; then
  echo "Commit message contains a Co-Authored-By trailer. Remove it (CLAUDE.md §4)."
  exit 1
fi
