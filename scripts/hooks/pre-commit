#!/usr/bin/env bash
# Pre-commit hook — fast checks only (runs on every commit)
# Full test suite runs in pre-push. Skip with: git commit --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

pass() { echo -e "${GREEN}✓${NC} $1"; }
fail() { echo -e "${RED}✗${NC} $1"; }
info() { echo -e "${YELLOW}→${NC} $1"; }

ERRORS=0

# Activate virtualenv if present
if [ -f "backend/.venv/bin/activate" ]; then
  # shellcheck disable=SC1091
  source backend/.venv/bin/activate
fi

# Resolve python binary (prefer venv, fall back to python3/python)
PYTHON="$(command -v python3 || command -v python || true)"
if [ -z "$PYTHON" ]; then
  echo "  python not found in PATH — skipping Python checks"
  PYTHON=""
fi

# ---------------------------------------------------------------------------
# 1–3. Legacy v1 checks. backend/ and frontend/ are deleted at decommission
# (PRODUCTION.md §10 step 12); each check skips cleanly when its dir is gone.
# ---------------------------------------------------------------------------
if [ -d backend/ccs_platform ]; then
  if [ -n "$PYTHON" ]; then
    info "Python syntax check (legacy backend)..."
    LEGACY_PY_DIRS="backend/ccs_platform"
    [ -d backend/scripts ] && LEGACY_PY_DIRS="$LEGACY_PY_DIRS backend/scripts"
    # shellcheck disable=SC2086
    if "$PYTHON" -m compileall -q $LEGACY_PY_DIRS 2>&1; then
      pass "Python syntax OK"
    else
      fail "Python syntax errors found"
      ERRORS=$((ERRORS + 1))
    fi
  fi

  info "Bandit SAST (legacy backend)..."
  BANDIT="$(command -v bandit || true)"
  if [ -n "$BANDIT" ]; then
    if "$BANDIT" -q -r backend/ccs_platform -x backend/tests -ll -ii 2>&1; then
      pass "Bandit SAST OK"
    else
      fail "Bandit found security issues"
      ERRORS=$((ERRORS + 1))
    fi
  else
    echo "  bandit not found — skipping (pip install bandit)"
  fi
else
  info "Legacy backend/ not present — skipping syntax and bandit checks"
fi

STAGED_FRONTEND=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^frontend/src/.*\.(ts|tsx)$' || true)

if [ -n "$STAGED_FRONTEND" ] && [ -f frontend/package.json ]; then
  info "ESLint (legacy frontend)..."
  if (cd frontend && npm run lint --silent 2>&1); then
    pass "ESLint OK"
  else
    fail "ESLint errors found"
    ERRORS=$((ERRORS + 1))
  fi
else
  info "ESLint (legacy frontend) — nothing staged or frontend/ absent, skipping"
fi

# ---------------------------------------------------------------------------
# 4. Ledger web ESLint + Vitest (only if apps/web files changed)
# ---------------------------------------------------------------------------
STAGED_LEDGER_WEB=$(git diff --cached --name-only | grep -E '^apps/web/.*\.(ts|tsx)$' || true)

if [ -n "$STAGED_LEDGER_WEB" ]; then
  if command -v pnpm >/dev/null 2>&1; then
    info "ESLint (apps/web)..."
    if pnpm --silent --filter @ledger/web lint 2>&1; then
      pass "ESLint (apps/web) OK"
    else
      fail "ESLint (apps/web) errors found"
      ERRORS=$((ERRORS + 1))
    fi
    info "Vitest (apps/web)..."
    if pnpm --silent --filter @ledger/web test 2>&1; then
      pass "Vitest (apps/web) OK"
    else
      fail "Vitest (apps/web) failed"
      ERRORS=$((ERRORS + 1))
    fi
  else
    echo "  pnpm not found — skipping apps/web checks (corepack enable)"
  fi
else
  info "ESLint/Vitest — no apps/web .ts/.tsx files staged, skipping"
fi

# ---------------------------------------------------------------------------
# 5. Scraper tests (only if scraper files changed)
# ---------------------------------------------------------------------------
STAGED_SCRAPER=$(git diff --cached --name-only | grep -E '^scraper/' || true)

if [ -n "$STAGED_SCRAPER" ]; then
  info "Scraper tests..."
  if [ -f "scraper/.venv/bin/pytest" ]; then
    if (cd scraper && .venv/bin/pytest 2>&1); then
      pass "Scraper tests OK"
    else
      fail "Scraper tests failed"
      ERRORS=$((ERRORS + 1))
    fi
  else
    echo "  scraper/.venv not found — skipping (cd scraper && pip install -e '.[dev]')"
  fi
else
  info "Scraper tests — no scraper files staged, skipping"
fi

# ---------------------------------------------------------------------------
echo ""
if [ "$ERRORS" -gt 0 ]; then
  echo -e "${RED}Pre-commit failed ($ERRORS check(s)). Fix the issues above or use --no-verify to skip.${NC}"
  exit 1
else
  echo -e "${GREEN}All pre-commit checks passed.${NC}"
fi
