# =============================================================================
# CCS Scraper — environment variables
# Copy to .env in the scraper/ directory and fill in values.
# All scraper vars use the CCS_SCRAPER_ prefix.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend connection
# ---------------------------------------------------------------------------

# Base URL uploads are sent to.
#   Legacy FastAPI backend: http://127.0.0.1:8040 (default)
#   Ledger v2 (Supabase):   your SUPABASE_URL, e.g. https://<project-ref>.supabase.co
CCS_SCRAPER_TARGET_URL=http://127.0.0.1:8040

# Upload route appended to CCS_SCRAPER_TARGET_URL.
#   Legacy FastAPI backend: /api/v1/jobs/upload (default)
#   Ledger v2 Edge Function: /functions/v1/statements-upload
# CCS_SCRAPER_UPLOAD_PATH=/functions/v1/statements-upload

# Service API token(s), sent as `Authorization: Bearer <token>`.
# Ledger v2 tokens belong to ONE profile and need the `statements:upload` scope:
# set one per profile as <PROFILE>_CCS_SCRAPER_API_TOKEN (profile upper-cased,
# like the bank credentials below). It takes precedence over the global
# CCS_SCRAPER_API_TOKEN, which is the fallback for profiles without their own
# (and the single token the legacy backend uses, scope `email_ingestion:upload`).
HUSSAIN_CCS_SCRAPER_API_TOKEN=
TEJASVIE_CCS_SCRAPER_API_TOKEN=
CCS_SCRAPER_API_TOKEN=

# Optional Supabase anon/publishable key. When set it is sent as the `apikey`
# header, which the Supabase gateway requires in some setups. Not a secret,
# but leave blank for the legacy backend.
# CCS_SCRAPER_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------

# Run browser without a visible window (set false to debug scrape sessions).
CCS_SCRAPER_HEADLESS=true

# Optional HTTP/SOCKS5 proxy for all browser traffic.
# CCS_SCRAPER_BROWSER_PROXY_URL=socks5://127.0.0.1:1080

# Geolocation reported by the browser (decimal degrees — defaults to Dubai).
CCS_SCRAPER_BROWSER_GEO_LATITUDE=25.2048
CCS_SCRAPER_BROWSER_GEO_LONGITUDE=55.2708

# Timezone and locale the browser advertises.
CCS_SCRAPER_BROWSER_TIMEZONE_ID=Asia/Dubai
CCS_SCRAPER_BROWSER_LOCALE=en-AE

# Local directory to save downloaded PDFs before upload.
CCS_SCRAPER_DOWNLOAD_DIR=./downloads

# ---------------------------------------------------------------------------
# Bank credentials — hussain
# ---------------------------------------------------------------------------
# Select this profile with: ccs-scraper scrape --profile hussain
# Provide credentials for each bank you want to scrape. Unused banks can be
# left blank — the scraper skips banks with missing credentials.

HUSSAIN_FAB_USERNAME=
HUSSAIN_FAB_PASSWORD=

HUSSAIN_ADCB_CID=
HUSSAIN_ADCB_LOGIN_PASSWORD=
HUSSAIN_ADCB_PDF_PASSWORD=
# HUSSAIN_ADCB_FORCE_VIRTUAL_KEYBOARD=1

HUSSAIN_ENBD_USERNAME=
HUSSAIN_ENBD_PASSWORD=

HUSSAIN_EIB_USERNAME=
HUSSAIN_EIB_PASSWORD=

HUSSAIN_SIB_USER_ID=
HUSSAIN_SIB_PASSWORD=
HUSSAIN_SIB_PDF_PASSWORD=
# HUSSAIN_SIB_SECURE_IMAGE_TEMPLATE_BASE64=

HUSSAIN_MASHREQ_USERNAME=
HUSSAIN_MASHREQ_PASSWORD=

# ---------------------------------------------------------------------------
# Bank credentials — tejasvie
# ---------------------------------------------------------------------------
# Select this profile with: ccs-scraper scrape --profile tejasvie

TEJASVIE_FAB_USERNAME=
TEJASVIE_FAB_PASSWORD=

TEJASVIE_ADCB_CID=
TEJASVIE_ADCB_LOGIN_PASSWORD=
TEJASVIE_ADCB_PDF_PASSWORD=
# TEJASVIE_ADCB_FORCE_VIRTUAL_KEYBOARD=1

TEJASVIE_ENBD_USERNAME=
TEJASVIE_ENBD_PASSWORD=

TEJASVIE_EIB_USERNAME=
TEJASVIE_EIB_PASSWORD=

TEJASVIE_SIB_USER_ID=
TEJASVIE_SIB_PASSWORD=
TEJASVIE_SIB_PDF_PASSWORD=
# TEJASVIE_SIB_SECURE_IMAGE_TEMPLATE_BASE64=

TEJASVIE_MASHREQ_USERNAME=
TEJASVIE_MASHREQ_PASSWORD=
