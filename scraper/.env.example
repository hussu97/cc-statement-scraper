# =============================================================================
# CCS Scraper — environment variables
# Copy to .env in the scraper/ directory and fill in values.
# All scraper vars use the CCS_SCRAPER_ prefix.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend connection
# ---------------------------------------------------------------------------

# URL of the running CCS Platform backend API.
CCS_SCRAPER_TARGET_URL=http://127.0.0.1:8040

# Service API token with `upload` scope. Generate in admin UI → Service API Tokens.
CCS_SCRAPER_API_TOKEN=

# Profile key to tag uploaded statements under (matches admin UI profile).
CCS_SCRAPER_PROFILE_KEY=alice

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------

# Run browser without a visible window (set false to debug scrape sessions).
CCS_SCRAPER_HEADLESS=true

# Optional HTTP/SOCKS5 proxy for all browser traffic.
# CCS_SCRAPER_BROWSER_PROXY_URL=socks5://127.0.0.1:1080

# Geolocation reported by the browser (decimal degrees — defaults to Dubai).
CCS_SCRAPER_BROWSER_GEO_LATITUDE=25.2048
CCS_SCRAPER_BROWSER_GEO_LONGITUDE=55.2708

# Timezone and locale the browser advertises.
CCS_SCRAPER_BROWSER_TIMEZONE_ID=Asia/Dubai
CCS_SCRAPER_BROWSER_LOCALE=en-AE

# Local directory to save downloaded PDFs before upload.
CCS_SCRAPER_DOWNLOAD_DIR=./downloads

# ---------------------------------------------------------------------------
# Bank credentials
# ---------------------------------------------------------------------------
# Provide credentials for each bank you want to scrape. Unused banks can be
# left blank — the scraper skips banks with missing credentials.

FAB_USERNAME=
FAB_PASSWORD=

ADCB_CID=
ADCB_LOGIN_PASSWORD=
ADCB_PDF_PASSWORD=
# ADCB_FORCE_VIRTUAL_KEYBOARD=1

ENBD_USERNAME=
ENBD_PASSWORD=

EIB_USERNAME=
EIB_PASSWORD=

SIB_USER_ID=
SIB_PASSWORD=
SIB_PDF_PASSWORD=
# SIB_SECURE_IMAGE_TEMPLATE_BASE64=

MASHREQ_USERNAME=
MASHREQ_PASSWORD=
