        ["ink", "bg"], ["ink", "surface"], ["ink", "surface-2"], ["ink", "warn-soft"],
        ["ink-2", "bg"], ["ink-2", "surface"], ["ink-2", "surface-2"], ["ink-2", "surface-3"], ["ink-2", "accent-soft"],
        ["muted", "bg"], ["muted", "surface"], ["muted", "surface-2"], ["muted", "warn-soft"],
        ["accent", "bg"], ["accent", "surface"], ["accent", "accent-soft"],
        ["accent-ink", "accent"],
        ["positive", "surface"], ["positive", "positive-soft"],
        ["warn", "surface"], ["warn", "warn-soft"],
        ["danger", "bg"], ["danger", "surface"], ["danger", "danger-soft"],
        ["info", "surface"], ["info", "info-soft"]
      ],
      "graphics": [
        ["subtle", "bg"], ["subtle", "surface"], ["subtle", "surface-2"],
        ["warn", "surface"], ["warn", "warn-soft"]
      ]
