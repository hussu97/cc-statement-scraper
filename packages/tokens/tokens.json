  "contrast": {
    "$description": "Pairs checked by test/contrast.test.mjs in BOTH themes. text: WCAG AA 4.5:1 (normal-size text). graphics: 3:1 (chart marks, focus rings, glyphs). text/graphics are the web's; ios holds the iPhone app's own text/graphics lists. Names are color.* tokens, or chart.* when prefixed 'chart.'. Add a pair here whenever a new foreground/background combination ships.",
    "text": [
      ["ink", "bg"], ["ink", "surface"], ["ink", "surface-2"],
      ["ink-2", "bg"], ["ink-2", "surface"], ["ink-2", "surface-2"],
      ["muted", "bg"], ["muted", "surface"], ["muted", "surface-2"],
      ["subtle", "bg"], ["subtle", "surface"], ["subtle", "surface-2"],
      ["accent", "bg"], ["accent", "surface"], ["accent", "surface-2"], ["accent", "accent-soft"],
      ["accent-hover", "bg"], ["accent-hover", "surface"],
      ["accent-ink", "accent"],
      ["positive", "bg"], ["positive", "surface"], ["positive", "positive-soft"],
      ["warn", "bg"], ["warn", "surface"], ["warn", "warn-soft"],
      ["danger", "bg"], ["danger", "surface"], ["danger", "danger-soft"],
      ["info", "bg"], ["info", "surface"], ["info", "info-soft"],
      ["chart.axis", "surface"], ["chart.axis", "bg"]
    ],
    "graphics": [
      ["focus", "bg"], ["focus", "surface"],
      ["chart.uncategorized", "surface"], ["chart.uncategorized", "bg"]
    ],
    "ios": {
      "$description": "The iPhone app's pairs (apps/ios/Ledger, Palette.* in Tokens.swift), checked like the web's. Text never uses `subtle` (glyphs and dividers only; LedgerKit PaletteUsageTests). Chips are Tone.color on Tone.softColor.",
