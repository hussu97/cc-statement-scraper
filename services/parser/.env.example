# Shared secret the Supabase worker sends in the X-Parser-Secret header (required; requests fail closed without it).
PARSER_SECRET=change-me-to-a-long-random-string

# Optional hardening / limits
# Comma-separated host allow-list for document_url (e.g. <project>.supabase.co). Empty = any https host.
PARSER_ALLOWED_HOSTS=
# Max PDF download size in MB (default 25).
PARSER_MAX_DOWNLOAD_MB=25
# Allow plain-http document URLs (local development only).
PARSER_ALLOW_HTTP=false

# Sentry (all optional; Sentry is disabled when SENTRY_DSN is empty)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.2

LOG_LEVEL=INFO
# Port for local runs; Cloud Run injects PORT automatically.
PORT=8080
