# Dockerfile.gmail-relay — lightweight image for the Gmail Pub/Sub relay.
# Runs gmail_ingest_relay.py as a FastAPI service via uvicorn on PORT (default 8080).

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN useradd -m -u 1000 appuser

WORKDIR /app

COPY backend/requirements.txt ./
# pip is uninstalled after the install for the same reason as in Dockerfile.api:
# no package installer is needed at runtime, and pip's vendored-dependency SBOM
# otherwise shows up as vulnerability findings in image scans.
RUN pip install --upgrade pip \
    && grep -v '^-e' requirements.txt | pip install -r /dev/stdin \
    && python -m pip uninstall -y pip

COPY backend/scripts/gmail_ingest_relay.py \
     backend/scripts/email_ingestion_common.py \
     ./

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8080

CMD ["sh", "-c", "uvicorn gmail_ingest_relay:app --host 0.0.0.0 --port ${PORT:-8080}"]