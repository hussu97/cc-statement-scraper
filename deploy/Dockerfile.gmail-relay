# Dockerfile.gmail-relay — lightweight image for the Gmail Pub/Sub relay.
# Runs gmail_ingest_relay.py as a FastAPI service via uvicorn on PORT (default 8080).

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY backend/requirements.txt ./
RUN pip install --upgrade pip \
    && pip install -r requirements.txt

COPY backend/scripts/gmail_ingest_relay.py \
     backend/scripts/email_ingestion_common.py \
     ./

EXPOSE 8080

CMD ["sh", "-c", "uvicorn gmail_ingest_relay:app --host 0.0.0.0 --port ${PORT:-8080}"]
