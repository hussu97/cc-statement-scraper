# Dockerfile.api — slim image for the HTTP API process only.
# Does NOT include Playwright or browser dependencies (~500 MB savings).
# Use this for the `api` service in docker-compose.prod.yml.
#
# For the scraping worker (needs Playwright) use Dockerfile.app.
# For Render free-tier (embedded worker in same process) use Dockerfile.app.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt backend/requirements-dev.txt backend/pyproject.toml README.md ./
COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
COPY backend/config ./config
COPY backend/ccs_platform ./ccs_platform

RUN pip install --upgrade pip \
    && pip install -r requirements.txt

EXPOSE 8040

CMD ["python", "-m", "ccs_platform.cli", "api", "--host", "0.0.0.0", "--port", "8040"]
