# Dockerfile.api — slim image for the HTTP API process (with embedded worker).
# Does NOT include Playwright or browser dependencies.
# Used for Render free-tier and all production API deployments.
# Browser scraping runs locally via the standalone scraper/ CLI tool.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 appuser

WORKDIR /app

# Copy dependency files first so pip install is cached unless requirements change
COPY backend/requirements.txt backend/requirements-dev.txt backend/pyproject.toml README.md ./
# pip is uninstalled once the dependencies are in place: a runtime image needs no
# package installer, and pip bundles copies of its own dependencies together with
# a CycloneDX SBOM (pip/_vendor/bom.cdx.json) that image scanners read as if those
# copies were installed packages — reporting CVEs for code this app never imports.
RUN pip install --upgrade pip \
    && pip install ".[export]" \
    && python -m pip uninstall -y pip

# Copy remaining source (changes here won't re-trigger pip install)
COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
COPY backend/config ./config
COPY backend/ccs_platform ./ccs_platform

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8040

CMD ["python", "-m", "ccs_platform.cli", "api", "--host", "0.0.0.0", "--port", "8040"]
