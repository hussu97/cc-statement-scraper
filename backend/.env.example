# =============================================================================
# CCS Platform — backend environment variables
# Copy to .env at the repo root and fill in values.
# All vars use the CCS_PLATFORM_ prefix (read by pydantic-settings).
# =============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development | production
CCS_PLATFORM_ENVIRONMENT=development

# IANA timezone used for billing month calculations and display.
CCS_PLATFORM_TIMEZONE=Asia/Dubai

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite (development default — path relative to repo root):
CCS_PLATFORM_DATABASE_URL=sqlite:///data/state/platform.db

# PostgreSQL (production):
# CCS_PLATFORM_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------

# local | gcs
CCS_PLATFORM_STORAGE_BACKEND=local

# Used when STORAGE_BACKEND=local
CCS_PLATFORM_LOCAL_STORAGE_DIR=data/archive/platform
CCS_PLATFORM_BACKUPS_DIR=data/backups

# Used when STORAGE_BACKEND=gcs
# CCS_PLATFORM_GCS_BUCKET=your-bucket-name
# CCS_PLATFORM_GCS_PROJECT=your-gcp-project-id
# CCS_PLATFORM_GCS_CREDENTIALS_FILE=/path/to/service-account.json

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# true: API process runs a background worker thread.
# false: run the worker as a separate process with `python -m ccs_platform.cli worker`.
CCS_PLATFORM_EMBEDDED_WORKER=true

# Number of concurrent worker threads.
CCS_PLATFORM_MAX_WORKER_THREADS=1

# Optional independent cap on concurrent active jobs (defaults to MAX_WORKER_THREADS).
# CCS_PLATFORM_WORKER_MAX_ACTIVE_JOBS=2

# Comma-separated queue names this process consumes.
# default: all job types (upload, reclassify, export, reparse, parser_validate)
CCS_PLATFORM_WORKER_QUEUES=default

# database: jobs are enqueued as DB rows; worker loop polls and picks them up.
# inprocess: API executes jobs inline (only useful for single-process dev).
CCS_PLATFORM_JOB_DISPATCH_BACKEND=database

# ---------------------------------------------------------------------------
# Job retry and heartbeat
# ---------------------------------------------------------------------------

# Retry back-off: base + jitter seconds, capped at max.
CCS_PLATFORM_JOB_RETRY_BASE_SECONDS=30
CCS_PLATFORM_JOB_RETRY_JITTER_SECONDS=15
CCS_PLATFORM_JOB_RETRY_MAX_DELAY_SECONDS=900

# How often the worker updates the heartbeat timestamp for running jobs (seconds).
CCS_PLATFORM_JOB_HEARTBEAT_INTERVAL_SECONDS=15

# Jobs without a heartbeat update beyond this threshold are marked for recovery.
CCS_PLATFORM_JOB_HEARTBEAT_TIMEOUT_SECONDS=1800

# Maximum wall-clock duration for a running job (seconds). The job is auto-cancelled
# once this limit elapses, regardless of heartbeat health. Set to 0 to disable.
CCS_PLATFORM_JOB_MAX_DURATION_SECONDS=1800

# ---------------------------------------------------------------------------
# Queue SLOs (surfaced by /health/ready and /metrics)
# ---------------------------------------------------------------------------

CCS_PLATFORM_QUEUE_BACKLOG_SLO_DEFAULT=100
CCS_PLATFORM_QUEUE_OLDEST_AGE_SLO_SECONDS=900

# ---------------------------------------------------------------------------
# Retention policy
# ---------------------------------------------------------------------------

CCS_PLATFORM_RETENTION_JOBS_DAYS=90
CCS_PLATFORM_RETENTION_EXPORTS_DAYS=90
CCS_PLATFORM_RETENTION_AUDIT_EVENTS_DAYS=365
CCS_PLATFORM_RETENTION_LOGS_DAYS=30
CCS_PLATFORM_RETENTION_UPLOADS_DAYS=14
CCS_PLATFORM_RETENTION_BACKUPS_DAYS=30

# ---------------------------------------------------------------------------
# API / HTTP
# ---------------------------------------------------------------------------

CCS_PLATFORM_CORS_ALLOW_ORIGINS=*
CCS_PLATFORM_LOG_LEVEL=INFO
CCS_PLATFORM_REQUEST_LOGGING_ENABLED=true

# ---------------------------------------------------------------------------
# Authentication (cookie-session, no API tokens)
# ---------------------------------------------------------------------------

CCS_PLATFORM_REQUIRE_LOGIN=true
CCS_PLATFORM_SESSION_COOKIE_NAME=ccs_session

# Session lifetime in seconds (default: 14 days).
CCS_PLATFORM_SESSION_MAX_AGE_SECONDS=1209600

# REQUIRED in production — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CCS_PLATFORM_SESSION_SECRET_KEY=change-this-in-production

# Admin login password hashes (bcrypt). Generate with:
#   cd backend && python -m ccs_platform.cli hash-password
# Paste the $2b$... output here. Never store plaintext passwords.
CCS_PLATFORM_LOGIN_HASH_HUSSAIN=
CCS_PLATFORM_LOGIN_HASH_BOB=

# Defaults to true in production, false in development.
# CCS_PLATFORM_SESSION_COOKIE_SECURE=true

# RBAC defaults to enabled in production; both seeded accounts are admin.
# CCS_PLATFORM_RBAC_ENABLED=true

# ---------------------------------------------------------------------------
# Runtime settings (DB-backed scraper credentials, editable via admin UI)
# ---------------------------------------------------------------------------

# Encryption is required in production by default.
# In development you can disable it:
# CCS_PLATFORM_RUNTIME_SETTINGS_REQUIRE_ENCRYPTION=false

# Fernet encryption key — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CCS_PLATFORM_RUNTIME_SETTINGS_ENCRYPTION_KEY=

# Controls how runtime settings are seeded into the DB on startup:
#   env_file_then_env  (default in development) — reads .env file first, then env
#   env                (default in production)   — reads process env only
#   env_file           — reads .env file only
#   none               — no automatic seeding
# CCS_PLATFORM_RUNTIME_SETTINGS_SEED_SOURCE=env_file_then_env

# Override the source .env file path for env_file* seed modes.
# CCS_PLATFORM_RUNTIME_SETTINGS_ENV_FILE=/app/.env

# Set true only in development to allow secret values to be returned by the API.
# CCS_PLATFORM_RUNTIME_SETTINGS_EXPOSE_SECRETS=false

# Enable email-driven PDF ingestion APIs and UI.
CCS_PLATFORM_EMAIL_INGESTION_ENABLED=false

# ---------------------------------------------------------------------------
# Development-only
# ---------------------------------------------------------------------------

# Allow the legacy SQLite auto-reset behavior (wipes DB on schema mismatch).
# Never enable in production.
CCS_PLATFORM_ALLOW_LEGACY_SQLITE_RESET=true

# ---------------------------------------------------------------------------
# PDF decryption passwords (seeded into runtime settings)
# ---------------------------------------------------------------------------
# The backend PDF parser needs these to open encrypted bank statements.
# Set them here to seed on first boot, or enter them via the admin UI
# (Runtime Variables page) at any time.
#
# Format: <PROFILE_KEY>_<SETTING>=value
#
# ALICE_ADCB_PDF_PASSWORD=
# ALICE_ADCB_CID=
# ALICE_SIB_PDF_PASSWORD=
#
# BOB_ADCB_PDF_PASSWORD=
# BOB_ADCB_CID=
# BOB_SIB_PDF_PASSWORD=
#
# OAuth app credentials — profile-agnostic, shared across all mailboxes.
# Set these here (or as server env vars) to enable the in-UI OAuth token flow.
# The admin UI → Email Ingestion → OAuth Token Setup panel uses them to generate
# auth URLs and to exchange codes for refresh tokens server-side.
CCS_PLATFORM_EMAIL_MS_CLIENT_ID=
CCS_PLATFORM_EMAIL_MS_CLIENT_SECRET=
CCS_PLATFORM_EMAIL_GMAIL_CLIENT_ID=
CCS_PLATFORM_EMAIL_GMAIL_CLIENT_SECRET=
