# Edge Function secrets: every key the functions read (Deno.env.get), names only.
#
# Local:      copy to supabase/functions/.env and fill in what you need, then
#             `supabase functions serve --env-file supabase/functions/.env`.
# Production: the gitignored supabase/functions/.env.production, pushed with
#             scripts/cutover/set-edge-secrets.sh (PRODUCTION.md §2.5). Never commit values.
#
# Injected by Supabase (do not set): SUPABASE_URL, SUPABASE_SECRET_KEYS,
# SUPABASE_PUBLISHABLE_KEYS, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY,
# SB_REGION, SB_EXECUTION_ID.

# ── Required (every environment) ────────────────────────────────────────────
# Must equal Vault `edge_cron_secret`; pg_cron sends it as x-cron-secret.
CRON_SECRET=
# Parser base URL (Cloud Run in production) and the shared X-Parser-Secret.
PARSER_URL=
PARSER_SECRET=

# ── Production only (or to test that integration locally) ──────────────────
ALLOWED_ORIGINS=
SENTRY_DSN=
# `production` in prod; unset/local/development/test never report.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
ANTHROPIC_API_KEY=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SA_EMAIL=
GMAIL_PUBSUB_TOPIC=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# ── Local only (never in production; set-edge-secrets.sh refuses them) ──────
# Rewrites signed Storage URLs (http://kong:8000) to a host the local parser can reach.
PARSER_DOCUMENT_BASE_URL=
# Enables _tests/e2e_local_test.ts (read by the test runner, not the functions).
LEDGER_E2E=
# Optional custom key names for local/manual runs (the runtime injects the real ones).
SB_SECRET_KEY=
SB_PUBLISHABLE_KEY=

# ── Optional overrides (defaults in README "Environment variables") ─────────
LLM_MODEL=
TERMSHEET_LLM_MODEL=
MS_OAUTH_TENANT=
OUTLOOK_LOOKBACK_DAYS=
OUTLOOK_BUDGET_MS=
GMAIL_PUSH_BUDGET_MS=
# Gmail errors stay out of Sentry until Gmail is configured; set to "on" to report them.
GMAIL_SENTRY_ALERTS=
WORKER_BUDGET_MS=
PARSER_TIMEOUT_MS=
EDGE_WALL_CLOCK_MS=
OPS_SMS_UNPARSED_THRESHOLD=
OPS_OPEN_REVIEWS_THRESHOLD=
OPS_QUEUED_DOCUMENT_AGE_S=
SENTRY_TRACES_SAMPLE_RATE=
# rl360-sync: JSON array [{"profile_code":"prf_…","username":"…","password":"…"}]; unset skips the sync
RL360_LOGINS=
