# Copy to supabase/.env (gitignored). The Supabase CLI loads it for env() in config.toml.
# Production identity for [remotes.production]: the repository names neither value.
# Required before `supabase config push` (the guard hook refuses it otherwise); every
# other command only needs a 20-character ref, so CI uses a placeholder.
SUPABASE_PROD_PROJECT_REF=
SUPABASE_PROD_SITE_URL=
